DATABASE_URL=postgresql+asyncpg://bioloupe:bioloupe@localhost:5432/bioloupe
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
AWS_S3_BUCKET_PREFIX=bioloupe
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ENVIRONMENT=development

# JWT Authentication Configuration 🔒
# Generate a secure key, for example: `openssl rand -base64 32`
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-base64-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Invitation token TTL (hours)
INVITATION_TOKEN_TTL_HOURS=72

# OAuth 2.0 Provider Configuration (Free Tier)
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ORCID OAuth: https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# OAuth Redirect Base URL (frontend URL)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Demo account (development only)
DEMO_ENABLED=true
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=DemoPass1!
DEMO_FULL_NAME="Demo User"
DEMO_TEAM_NAME="Demo Team"
DEMO_SESSION_TITLE="Welcome to BioLoupe"

AUDIT_LOG_RETENTION_DAYS=90
AUDIT_ENABLE_BACKGROUND_LOGGING=true

# ML Model Configuration
ML_MODELS_CACHE_DIR=/tmp/ml_models
ML_DEVICE=auto                    # auto, cpu, cuda:0
ML_ENABLE_CACHING=true
ML_BATCH_SIZE=32
ML_CACHE_TTL_SECONDS=3600
ML_MODEL_WARMUP=true
ML_PRECISION=float32              # float32, float16, int8
ML_UNLOAD_TIMEOUT_MINUTES=30
